# Required: MongoDB connection used by the Flask app, Streamlit dashboard, and jobs.
# For MongoDB Atlas, URL-encode special characters in the username/password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cozmoz

# Required: shared secret for protected internal endpoints and webhook verification.
# Generate a long random value; do not reuse a social-media or OpenAI token.
VERIFY_TOKEN=replace-with-a-long-random-secret

# Required in production: public HTTPS URL where this app is reachable.
# Do not include a trailing slash.
BASE_URL=https://your-domain.example

# Required for AI replies, file uploads, and vector-store search.
OPENAI_API_KEY=sk-your-openai-project-key

# Optional: seconds to wait after the latest inbound message before batching it.
BATCH_WINDOW_SECONDS=10

# Optional: default Responses API model used for new clients.
DEFAULT_OPENAI_MODEL=gpt-4.1-mini

# Optional legacy fallback settings. Per-client tokens and AI configuration are
# stored in MongoDB and managed from the dashboard, so most deployments leave
# these unset.
# DEFAULT_PAGE_ACCESS_TOKEN=
# DEFAULT_FB_ACCESS_TOKEN=
# DEFAULT_PAGE_ID=
# DEFAULT_OPENAI_API_KEY=
